<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.togethersafe.desktop.controller.survivor.SafetyPlanningController" styleClass="root">
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area">
            <VBox spacing="24" style="-fx-padding: 32;">
                <Label text="Safety Planning" styleClass="h1"/>
                <Label text="Create a personalized safety plan. This is private and encrypted." styleClass="body-text" wrapText="true"/>
                
                <HBox spacing="24">
                    <VBox styleClass="card" spacing="16" prefWidth="500">
                        <Label text="My Safety Plan" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label text="Safe Places" styleClass="body-text"/>
                        <TextArea fx:id="safePlacesField" promptText="Where can you go in an emergency?" prefRowCount="3"/>
                        
                        <Label text="Trusted Contacts" styleClass="body-text"/>
                        <TextArea fx:id="trustedContactsField" promptText="Who can you call for help?" prefRowCount="3"/>
                        
                        <Label text="Emergency Bag" styleClass="body-text"/>
                        <TextArea fx:id="emergencyBagField" promptText="What do you need to take?" prefRowCount="3"/>
                        
                        <Button text="Save Plan" styleClass="btn-primary" onAction="#handleSave"/>
                    </VBox>

                    <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
                        <Label text="Quick Safety Tips" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label text="• Keep your phone charged and with you at all times." styleClass="body-text" wrapText="true"/>
                        <Label text="• Memorize the 999 number." styleClass="body-text" wrapText="true"/>
                        <Label text="• Identify a safe place you can go at any time." styleClass="body-text" wrapText="true"/>
                        <Label text="• Keep an emergency bag hidden in a safe place." styleClass="body-text" wrapText="true"/>
                        <Label text="• Have a code word for a trusted friend to alert them." styleClass="body-text" wrapText="true"/>
                        <Label text="• Delete this app's browsing history if you share a device." styleClass="body-text" wrapText="true"/>
                    </VBox>
                </HBox>

                <Button fx:id="backButton" text="← Back to Home" styleClass="back-button" onAction="#goBack"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>