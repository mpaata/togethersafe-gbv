<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.togethersafe.desktop.controller.AdminPlaceholderController" styleClass="root">
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area">
            <VBox spacing="24" style="-fx-padding: 32;">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="Reports" styleClass="h1"/>
                        <Label text="Generate and export reports for stakeholders." styleClass="body-text"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Generate Report" styleClass="btn-primary"/>
                </HBox>

                <HBox spacing="24">
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="📊" style="-fx-font-size: 40px;"/>
                        <Label text="Monthly Report" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label text="Summary of all cases and referrals for the current month." styleClass="body-text" wrapText="true"/>
                        <Button text="Download PDF" styleClass="btn-primary"/>
                    </VBox>
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="📈" style="-fx-font-size: 40px;"/>
                        <Label text="Quarterly Impact" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label text="Q3 2026 impact metrics for donors and partners." styleClass="body-text" wrapText="true"/>
                        <Button text="Download PDF" styleClass="btn-primary"/>
                    </VBox>
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="📁" style="-fx-font-size: 40px;"/>
                        <Label text="Custom Export" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label text="Export any data to Excel or CSV." styleClass="body-text" wrapText="true"/>
                        <Button text="Configure →" styleClass="btn-primary"/>
                    </VBox>
                </HBox>

                <VBox styleClass="card" spacing="16">
                    <Label text="Recent Reports" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <ListView fx:id="recentReportsList" prefHeight="250"/>
                </VBox>

                <Button fx:id="backButton" text="← Back to Admin Dashboard" styleClass="back-button" onAction="#goBack"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>