<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.togethersafe.desktop.controller.LoginController"
           styleClass="root">

    <VBox alignment="CENTER" spacing="16" styleClass="card" maxWidth="450" maxHeight="700">
        
        <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
            <image><Image url="@/images/logo.jpeg"/></image>
        </ImageView>

        <Label fx:id="titleLabel" text="TogetherSafe" styleClass="h1"/>
        <Label fx:id="subtitleLabel" text="Sign in to continue" styleClass="body-text"/>

        <TextField fx:id="usernameField" promptText="Username" maxWidth="350" style="-fx-padding: 10;"/>
        <PasswordField fx:id="passwordField" promptText="Password" maxWidth="350" style="-fx-padding: 10;"/>
        
        <!-- Registration fields (hidden initially) -->
        <TextField fx:id="fullNameField" promptText="Full Name" maxWidth="350" style="-fx-padding: 10;" visible="false" managed="false"/>
        <ComboBox fx:id="roleCombo" promptText="Role" maxWidth="350" visible="false" managed="false" style="-fx-padding: 6;"/>

        <Button fx:id="signInButton" text="Sign In" styleClass="btn-primary" maxWidth="350" onAction="#handleLogin"/>
        
        <Button fx:id="registerButton" text="Create Account" styleClass="btn-secondary" maxWidth="350" onAction="#handleRegisterToggle"/>
        
        <Button text="Report Anonymously (No Login)" style="-fx-background-color: transparent; -fx-text-fill: #2E44A8; -fx-cursor: hand;" onAction="#handleAnonymousReport"/>

        <Label fx:id="errorLabel" style="-fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>
