<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.togethersafe.desktop.controller.survivor.MyCasesController"
            styleClass="root">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #FFFFFF; -fx-padding: 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <Label text="← Back to Home" styleClass="back-button" onMouseClicked="#goBack"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="My Cases" style="-fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox style="-fx-padding: 32;" spacing="24">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <Label text="My Cases" styleClass="h1"/>
                    <Label text="View and manage your reported cases." styleClass="body-text"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ New Case" styleClass="btn-primary" onAction="#handleNewCase"/>
            </HBox>

            <VBox styleClass="card" spacing="16">
                <TextField fx:id="searchField" promptText="Search by case ID or type..."/>
                <TableView fx:id="casesTable" prefHeight="500">
                    <columns>
                        <TableColumn fx:id="colCaseRef" text="Case ID" prefWidth="150"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="200"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="colPriority" text="Priority" prefWidth="120"/>
                        <TableColumn fx:id="colCreated" text="Created" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
