<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.togethersafe.desktop.controller.AdminPlaceholderController" styleClass="root">
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area">
            <VBox spacing="24" style="-fx-padding: 32;">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="Find Help Map" styleClass="h1"/>
                        <Label text="All verified services across Uganda." styleClass="body-text"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField promptText="Search location..." prefWidth="300"/>
                    <Button text="📍 Use My Location" styleClass="btn-primary"/>
                </HBox>

                <VBox styleClass="card" spacing="16" prefHeight="500">
                    <Label text="📍 Kampala, Uganda — 0.3476° N, 32.5825° E" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Region prefHeight="350" style="-fx-background-color: #EFF6FF; -fx-background-radius: 8;"/>
                    <Label text="Services near this location:" styleClass="body-text" style="-fx-font-weight: bold;"/>
                    <HBox spacing="16">
                        <Label text="🏠 4 Shelters" styleClass="body-text"/>
                        <Label text="💬 12 Counselling" styleClass="body-text"/>
                        <Label text="⚖️ 8 Legal Aid" styleClass="body-text"/>
                        <Label text="🏥 5 Medical" styleClass="body-text"/>
                    </HBox>
                </VBox>

                <Button fx:id="backButton" text="← Back to Admin Dashboard" styleClass="back-button" onAction="#goBack"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>