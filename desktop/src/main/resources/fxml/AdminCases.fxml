<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.togethersafe.desktop.controller.admin.AdminCasesController" styleClass="root">
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area">
            <VBox spacing="24" style="-fx-padding: 32;">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="All Cases" styleClass="h1"/>
                        <Label text="Manage every reported case across the organization." styleClass="body-text"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="Search cases..." prefWidth="300"/>
                    <Button text="+ New Case" styleClass="btn-primary" onAction="#handleNewCase"/>
                </HBox>

                <VBox styleClass="card" spacing="16">
                    <Label text="Recent Cases" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="casesTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="colRef" text="Case ID" prefWidth="120"/>
                            <TableColumn fx:id="colVictim" text="Victim" prefWidth="150"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                            <TableColumn fx:id="colPriority" text="Priority" prefWidth="100"/>
                            <TableColumn fx:id="colAssigned" text="Assigned" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>

                <Button fx:id="backButton" text="← Back to Admin Dashboard" styleClass="back-button" onAction="#goBack"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>