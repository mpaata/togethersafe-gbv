<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.togethersafe.desktop.controller.admin.AdminEvidenceController" styleClass="root">
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area">
            <VBox spacing="24" style="-fx-padding: 32;">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="Evidence Vault" styleClass="h1"/>
                        <Label text="Review and verify all evidence files uploaded by survivors." styleClass="body-text"/>
                    </VBox>
                </HBox>

                <VBox styleClass="card" spacing="16">
                    <Label text="All Evidence Files" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="evidenceTable" prefHeight="500">
                        <columns>
                            <TableColumn fx:id="colFile" text="File Name" prefWidth="200"/>
                            <TableColumn fx:id="colCase" text="Case ID" prefWidth="120"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                            <TableColumn fx:id="colUploadedBy" text="Uploaded By" prefWidth="150"/>
                            <TableColumn fx:id="colChecksum" text="Checksum" prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>

                <Button fx:id="backButton" text="← Back to Admin Dashboard" styleClass="back-button" onAction="#goBack"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>