<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.togethersafe.desktop.controller.AdminPlaceholderController" styleClass="root">
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area">
            <VBox spacing="24" style="-fx-padding: 32;">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="Service Directory" styleClass="h1"/>
                        <Label text="Manage and verify service providers." styleClass="body-text"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField promptText="Search providers..." prefWidth="300"/>
                    <Button text="+ Add Service" styleClass="btn-primary"/>
                </HBox>

                <VBox styleClass="card" spacing="16">
                    <Label text="Verified Services" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView prefHeight="500">
                        <columns>
                            <TableColumn text="Service Name" prefWidth="200"/>
                            <TableColumn text="Category" prefWidth="120"/>
                            <TableColumn text="Location" prefWidth="150"/>
                            <TableColumn text="Contact" prefWidth="150"/>
                            <TableColumn text="Verified" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

                <Button fx:id="backButton" text="← Back to Admin Dashboard" styleClass="back-button" onAction="#goBack"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>